{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "my-map-capture",
  "main": "index.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "kv_namespaces": [
    {
      "binding": "LIVE_KV",
      "id": "e85f915f82d94d088eb180a850ea7005"
    }
  ],
  "ratelimits": [
    {
      "name": "LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["15 * * * *"]
  },
  "vars": {
    "APP_ORIGIN": "https://at5tram98-hash.github.io"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true
  }
}
